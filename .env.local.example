# --- Supabase ---
# Project Settings > API. Both are safe to expose to the browser;
# every table is protected by row-level security, not by key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Site ---
# Used for magic-link redirects and links inside notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Photo notification emails (optional) ---
# Leave blank to disable notifications entirely.
# Gmail app password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- scripts/check-rls.ts only ---
# Two throwaway accounts the RLS test signs in as. Create them in the
# Supabase dashboard (Authentication > Users) with email confirmation on.
RLS_TEST_EMAIL_A=rls-a@example.com
RLS_TEST_EMAIL_B=rls-b@example.com
RLS_TEST_PASSWORD=some-long-random-password
